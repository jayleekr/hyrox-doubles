# ---- Google Sheets (required) ----
# Production: paste the whole service-account JSON on one line.
# Share the spreadsheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local dev: leave the above empty and this file is used instead
# (the authorized_user credential the `gws` CLI already stores).
GOOGLE_OAUTH_CREDENTIALS_FILE=

SPREADSHEET_ID=1nNDRGp-FY2DU7w3y_akDwIO2GD1HePaoi7gxxYAf4Rc

# ---- Who is who ----
PLAYER_A_NAME=Jay
PLAYER_B_NAME=정재빈
# Personal URL secrets for the PWA: open it as https://<host>/?k=<key>
# Generate with:  node -e "console.log(crypto.randomUUID())"
PLAYER_A_KEY=
PLAYER_B_KEY=

# ---- Identity for the OpenClaw agent ----
# Numeric Telegram user ids. OpenClaw passes `--telegram <sender id>` so that who is
# logging is resolved exactly, never inferred from the wording of a message.
# An id that is not listed here is refused rather than guessed at.
TELEGRAM_USER_A=
TELEGRAM_USER_B=

# Nothing else is needed. The bot token, the schedule and the natural-language
# understanding all live in OpenClaw (~/.openclaw), not in this repo.
